# Copy to .env and fill in your own keys. Never commit .env.

# TikTok scraping (Apify) — required
APIFY_API_KEY=

# Per-video vision analysis (Google Gemini) — required
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro          # optional override

# Strategic layer (Anthropic Claude) — OPTIONAL.
# If unset, analyze.py authors the strategic layer directly and flags it.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6    # optional override
